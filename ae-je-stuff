                correct: 1,
                expEn: "An aggregate impact value of 30% or more indicates weak or soft aggregate, making it unsuitable for wearing course surface pavement.",
                expHi: "Agar impact value 30% ya usse zyada hai, toh iska matlab aggregate kamzor hai aur surface course banane ke liye thik nahi hai."
            },
            {
                meta: "State JE 2024 PYQ",
                text: "A line joining points of equal elevation on the surface of earth is known as:",
                options: [
                    "Isogonic Line",
                    "Level Line",
                    "Contour Line",
                    "Horizontal Line"
                ],
                correct: 2,
                expEn: "Contour lines represent imaginary lines connecting points of equal elevation on the earth's surface.",
                expHi: "Samaan unchayi (equal elevation) ke points ko jodne wali rekha ko contour line kehte hain."
            }
        ];

        let currentQIndex = 0;
        let userScore = 0;

        // Initialize App & Tabs
        window.onload = () => {
            // Theme setup
            if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
            
            // Notepad Persistence load
            document.getElementById('civil-notes').value = localStorage.getItem('learnix_civil_notes') || "";
            
            // Load Quiz
            loadQuestion();
        };

        // Tab Switching Logic
        function switchTab(tabId) {
            // Deactivate all buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-6 py-2.5 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full text-xs font-bold shadow-sm border border-slate-200 dark:border-slate-700 hover:border-primary transition-all flex items-center gap-2";
            });
            // Activate selected button
            document.getElementById('tab-' + tabId).className = "tab-btn px-6 py-2.5 bg-primary text-white rounded-full text-xs font-bold shadow-md shadow-blue-500/10 transition-all flex items-center gap-2";

            // Hide all sections
            document.getElementById('section-notes').classList.add('hidden');
            document.getElementById('section-pyq').classList.add('hidden');
            document.getElementById('section-tools').classList.add('hidden');

            // Show selected section
            document.getElementById('section-' + tabId).classList.remove('hidden');
        }

        // Accordion Toggle
        function toggleFormula(card) {
            const isActive = card.classList.contains('active');
            document.querySelectorAll('.formula-card').forEach(c => c.classList.remove('active'));
            if (!isActive) card.classList.add('active');
        }

        // Quiz Engine Logic
        function loadQuestion() {
            const q = pyqData[currentQIndex];
            document.getElementById('q-meta').innerText = q.meta;
            document.getElementById('q-text').innerText = q.text;
            
            const optionsBlock = document.getElementById('options-block');
            optionsBlock.innerHTML = '';
            
            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 bg-slate-50 dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-2xl font-bold text-xs transition-colors border border-transparent";
                btn.innerText = opt;
                btn.onclick = () => validateAnswer(idx, btn);
                optionsBlock.appendChild(btn);
            });

            document.getElementById('explanation-box').classList.add('hidden');
        }

        function validateAnswer(idx, selectedBtn) {
            const q = pyqData[currentQIndex];
            const optionsBlock = document.getElementById('options-block');
            
            // Disable all options
            Array.from(optionsBlock.children).forEach(btn => btn.disabled = true);

            if (idx === q.correct) {
                selectedBtn.className = "w-full text-left p-4 bg-emerald-500 text-white rounded-2xl font-bold text-xs border border-emerald-500";
                userScore++;
                document.getElementById('score-counter').innerText = `Score: ${userScore}/5`;
            } else {
                selectedBtn.className = "w-full text-left p-4 bg-rose-500 text-white rounded-2xl font-bold text-xs border border-rose-500";
                // Show correct answer in green
                optionsBlock.children[q.correct].className = "w-full text-left p-4 bg-emerald-500 text-white rounded-2xl font-bold text-xs border border-emerald-500";
            }

            // Show explanation
            document.getElementById('explanation-en').innerText = q.expEn;
            document.getElementById('explanation-hi').innerText = q.expHi;
            document.getElementById('explanation-box').classList.remove('hidden');
        }

        function nextQuestion() {
            currentQIndex++;
            if (currentQIndex < pyqData.length) {
                loadQuestion();
            } else {
                showModal("Quiz Completed!", `Good practice session! Your final score is ${userScore} out of 5. Keep analyzing formulas and structural standards!`, '🎖️');
                currentQIndex = 0;
                userScore = 0;
                document.getElementById('score-counter').innerText = `Score: 0/5`;
                loadQuestion();
            }
        }

        // Notepad Autosave
        const notesArea = document.getElementById('civil-notes');
        const saveIndicator = document.getElementById('note-saved');
        notesArea.addEventListener('input', () => {
            localStorage.setItem('learnix_civil_notes', notesArea.value);
            saveIndicator.classList.remove('opacity-0');
            setTimeout(() => saveIndicator.classList.add('opacity-0'), 1500);
        });

        // Site Calculator Functions
        const screen = document.getElementById('calc-screen');
        function pressCalc(val) {
            screen.value += val;
        }
        function clearCalc() {
            screen.value = '';
        }
        function evalCalc() {
            try {
                screen.value = eval(screen.value);
            } catch(e) {
                screen.value = 'Syntax Error';
            }
        }

        // Theme Toggle Handler
        const themeBtn = document.getElementById('theme-toggle');
        themeBtn.addEventListener('click', () => {
            html.classList.toggle('dark');
            localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        });
    </script>
</body>
</html>
